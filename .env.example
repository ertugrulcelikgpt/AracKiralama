# Lokal geliştirme ayarları. Bu dosyayı .env adıyla kopyala:  Copy-Item .env.example .env
# .env commit edilmez. Buradaki şifre sadece lokal Docker veritabanı içindir.
# CAP, CDS_REQUIRES_DB_CREDENTIALS_HOST anahtarını cds.requires.db.credentials.host olarak okur.
CDS_REQUIRES_DB_CREDENTIALS_HOST=localhost
CDS_REQUIRES_DB_CREDENTIALS_PORT=5432
CDS_REQUIRES_DB_CREDENTIALS_DATABASE=rentacar
CDS_REQUIRES_DB_CREDENTIALS_USER=postgres
CDS_REQUIRES_DB_CREDENTIALS_PASSWORD=postgres
