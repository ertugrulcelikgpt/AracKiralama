{
  "welcomeFile": "/index.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/(rentals|vehicles|customers|analytics)/webapp/(.*)$",
      "target": "/$1/webapp/$2",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    },
    {
      "source": "^/(rental|admin|analytics)/(.*)$",
      "target": "/$1/$2",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "localDir": "resources",
      "authenticationType": "xsuaa"
    }
  ]
}
