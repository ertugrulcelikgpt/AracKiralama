{
  "name": "rentacar",
  "version": "1.0.0",
  "description": "SAP CAP ile araç kiralama uygulaması (cap-sflight mimarisinden esinlenilmiştir)",
  "type": "module",
  "private": true,
  "dependencies": {
    "@cap-js/postgres": "^3.1.2",
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "eslint": "^10.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:deploy": "cds deploy",
    "db:reset": "docker compose down -v && docker compose up -d --wait && cds deploy",
    "lint": "eslint ."
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "postgres"
        },
        "[test]": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      }
    }
  }
}
