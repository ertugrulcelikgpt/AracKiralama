{
  "name": "rentacar",
  "version": "1.0.0",
  "description": "SAP CAP ile araç kiralama uygulaması (cap-sflight mimarisinden esinlenilmiştir)",
  "type": "module",
  "private": true,
  "dependencies": {
    "@cap-js/postgres": "^3.1.2",
    "@sap/cds": "^10",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "chai": "^6.3.0",
    "chai-as-promised": "^8.0.2",
    "eslint": "^10.13.0",
    "mocha": "^12.0.3"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "sandbox": "cds serve all --profile sandbox",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:deploy": "cds deploy --with-mocks",
    "db:reset": "docker compose down -v && docker compose up -d --wait && cds deploy --with-mocks",
    "lint": "eslint .",
    "test": "mocha",
    "test:pg": "mocha --config .mocharc.pg.json"
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "postgres"
        },
        "[test]": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        }
      },
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "agent": {
              "password": "agent",
              "roles": [
                "RentalAgent"
              ]
            },
            "manager": {
              "password": "manager",
              "roles": [
                "RentalAgent",
                "RentalManager"
              ]
            },
            "admin": {
              "password": "admin",
              "roles": [
                "FleetAdmin"
              ]
            }
          }
        },
        "[test]": {
          "kind": "mocked",
          "users": {
            "agent": {
              "password": "agent",
              "roles": [
                "RentalAgent"
              ]
            },
            "manager": {
              "password": "manager",
              "roles": [
                "RentalAgent",
                "RentalManager"
              ]
            },
            "admin": {
              "password": "admin",
              "roles": [
                "FleetAdmin"
              ]
            }
          }
        }
      },
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "[sandbox]": {
          "credentials": {
            "url": "https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap/API_BUSINESS_PARTNER",
            "requestTimeout": 10000
          }
        }
      }
    }
  }
}
